# Vercel/runtime traffic: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Administrative traffic: direct Supabase connection (port 5432).
MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
MIGRATION_DATABASE_SSL=true
MIGRATION_DATABASE_SSL_REJECT_UNAUTHORIZED=true

AUDIT_HASH_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development

# Transactional verification email. Verify the sender domain in Resend first.
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=WeekToDo <accounts@example.com>
