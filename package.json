{
  "name": "WeekToDo",
  "version": "2.2.0",
  "private": true,
  "description": "Free and Open Source Minimalist Weekly Planner focused on privacy.",
  "author": "Manuel Ernesto Garcia <contact@weektodo.me> (https://weektodo.me/)",
  "homepage": "https://weektodo.me",
  "keywords": [
    "ToDo",
    "Weekly Planner",
    "to-do",
    "Productivity",
    "Minimalist"
  ],
  "scripts": {
    "dev": "vite --mode web",
    "serve": "vite --mode web",
    "build": "vite build --mode web",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron:build": "vite build --mode electron && electron-builder",
    "electron:serve": "vite --mode electron",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "electron:verify": "vite build --mode electron && electron-builder --dir --win && node scripts/electron-smoke.mjs",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "release": "electron-builder",
    "server:start": "node --env-file-if-exists=.env.sync server/start.mjs",
    "server:migrate": "node --env-file-if-exists=.env.sync server/migrate.mjs",
    "server:maintenance": "node --env-file-if-exists=.env.sync server/maintenance.mjs",
    "server:function:verify": "node scripts/verify-vercel-runtime.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "dist-electron/main.js",
  "repository": "https://github.com/manuelernestog/weektodo",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.12.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@electron/asar": "^3.4.1",
    "@manuelernestog/click-handler": "^1.4.0",
    "@popperjs/core": "^2.11.0",
    "@sentry/vue": "^7.99.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.2.26",
    "auto-launch": "^5.0.5",
    "axios": "^1.4.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.5",
    "core-js": "^3.20.1",
    "cryptocurrency-icons": "^0.17.1",
    "date-fns": "^2.22.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7",
    "electron-config": "^2.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "linkify-string": "^3.0.4",
    "linkifyjs": "^3.0.5",
    "lodash.uniqueid": "^4.0.1",
    "markdown-it": "^13.0.1",
    "moment": "^2.29.1",
    "rrule": "^2.6.9",
    "sass": "^1.69.5",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0",
    "vue": "^3.2.26",
    "vue-i18n": "^9.1.9",
    "vue3-datepicker": "^0.2.5",
    "vuex": "^4.0.2"
  }
}
