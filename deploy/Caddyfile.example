planner.example.com {
  encode zstd gzip

  handle /v1/* {
    reverse_proxy sync-api:3000
  }

  handle /health/* {
    reverse_proxy sync-api:3000
  }

  handle {
    root * /srv/weektodo
    try_files {path} /index.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
  }
}
